// Prints the number of genomes per individual (1=haploid, 2=diploid)
initialize() {
    initializeSLiMOptions(keepPedigrees=T);
    initializeTreeSeq();
    initializeMutationRate(0.0);
}
1 early() { sim.addSubpop("p1", 10); }
1 late() {
    ind = p1.individuals[0];
    cat("genomes_per_individual\t" + size(ind.genomes) + "\n");
}
